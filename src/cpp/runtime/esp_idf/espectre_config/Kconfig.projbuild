menu "ESPectre Sensing"

choice ESPECTRE_WIFI_BAND_POLICY
    prompt "Wi-Fi band policy"
    default ESPECTRE_WIFI_BAND_2G
    help
        Keep the production CSI PHY at HT20 while choosing which radio band
        may be used. 5 GHz and automatic selection require dual-band silicon.

    config ESPECTRE_WIFI_BAND_2G
        bool "2.4 GHz only"

    config ESPECTRE_WIFI_BAND_5G
        bool "5 GHz only"
        depends on SOC_WIFI_SUPPORT_5G

    config ESPECTRE_WIFI_BAND_AUTO
        bool "Automatic 2.4/5 GHz selection"
        depends on SOC_WIFI_SUPPORT_5G
endchoice

choice ESPECTRE_DETECTION_ALGORITHM
    prompt "Detection profile"
    default ESPECTRE_DETECTION_ALGORITHM_LIGHTWEIGHT
    help
        Select the detector used by the shared ESPectre sensing runtime.

    config ESPECTRE_DETECTION_ALGORITHM_LIGHTWEIGHT
        bool "Lightweight Detection"
        help
            Lower active CPU and working-memory cost, with quiet-room startup
            threshold calibration.

    config ESPECTRE_DETECTION_ALGORITHM_HIGH_ACCURACY
        bool "High-Accuracy Detection"
        help
            Stronger detection quality and generalization, with additional
            feature state and neural-inference work. No threshold calibration.
endchoice

config ESPECTRE_SEGMENTATION_WINDOW_SIZE_MS
    int "Segmentation window duration (milliseconds)"
    range 1000 2000
    default 1000
    help
        Detector window in elapsed time. The runtime resolves this duration to
        samples from the measured valid CSI cadence.

config ESPECTRE_TRAFFIC_GENERATOR_RATE
    int "Target valid CSI rate (pps)"
    range 0 1000
    default 100
    help
        Zero disables internal traffic generation and expects external traffic.

config ESPECTRE_TRAFFIC_GENERATOR_ADAPTIVE
    bool "Adapt traffic rate from valid CSI callbacks"
    default y
    help
        Adjust the internal DNS or ping send rate to keep valid local CSI
        callbacks close to the configured target rate.

choice ESPECTRE_TRAFFIC_GENERATOR_MODE
    prompt "Traffic generator mode"
    default ESPECTRE_TRAFFIC_GENERATOR_MODE_PING

    config ESPECTRE_TRAFFIC_GENERATOR_MODE_DNS
        bool "DNS"

    config ESPECTRE_TRAFFIC_GENERATOR_MODE_PING
        bool "PING"
endchoice

config ESPECTRE_PUBLISH_INTERVAL_MS
    int "Publish interval (milliseconds)"
    range 100 60000
    default 1000

config ESPECTRE_EVALUATION_INTERVAL_MS
    int "Evaluation interval (milliseconds)"
    range 10 10000
    default 250

config ESPECTRE_MOTION_ON_HITS
    int "Motion-on hits"
    range 1 20
    default 4

config ESPECTRE_MOTION_OFF_HITS
    int "Motion-off hits"
    range 1 20
    default 3

config ESPECTRE_LOWPASS_ENABLED
    bool "Enable low-pass filter"
    default n

config ESPECTRE_LOWPASS_CUTOFF
    string "Low-pass cutoff (Hz)"
    default "11.0"
    depends on ESPECTRE_LOWPASS_ENABLED
    help
        Low-pass cutoff frequency as a decimal string in the 5.0-20.0 range.

config ESPECTRE_HAMPEL_ENABLED
    bool "Enable Hampel filter"
    default y

config ESPECTRE_HAMPEL_WINDOW
    int "Hampel window"
    range 3 11
    default 7
    depends on ESPECTRE_HAMPEL_ENABLED

config ESPECTRE_HAMPEL_THRESHOLD
    string "Hampel threshold (MAD)"
    default "5.0"
    depends on ESPECTRE_HAMPEL_ENABLED
    help
        Hampel threshold as a decimal string in the 1.0-10.0 range.

config ESPECTRE_DEBUG_TELEMETRY
    bool "Enable runtime debug telemetry"
    default n
    help
        Enable periodic ESPectre runtime DEBUG telemetry with heap, load, and
        timing metrics. The logs appear when the relevant runtime tags are
        raised to DEBUG, for example during firmware benchmarking. On-demand
        CSI and Wi-Fi diagnostics are available independently of this option.

endmenu
