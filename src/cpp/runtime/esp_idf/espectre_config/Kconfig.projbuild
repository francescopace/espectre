menu "ESPectre Sensing"

choice ESPECTRE_DETECTION_ALGORITHM
    prompt "Detection algorithm"
    default ESPECTRE_DETECTION_ALGORITHM_CLASSIC
    help
        Select the detector used by the shared ESPectre sensing runtime.

    config ESPECTRE_DETECTION_ALGORITHM_CLASSIC
        bool "CLASSIC"
        help
            Weighted L1-delta and turbulence-autocorrelation detector with startup
            threshold calibration.

    config ESPECTRE_DETECTION_ALGORITHM_ML
        bool "ML"
        help
            Neural-network detector with fixed threshold and no startup
            calibration.
endchoice

choice ESPECTRE_THRESHOLD_MODE
    prompt "Threshold mode"
    default ESPECTRE_THRESHOLD_MODE_AUTO
    help
        Select how the shared sensing runtime derives the active threshold.

    config ESPECTRE_THRESHOLD_MODE_AUTO
        bool "AUTO"
        help
            Adaptive threshold calibrated at boot.

    config ESPECTRE_THRESHOLD_MODE_MIN
        bool "MIN"
        help
            Adaptive threshold with maximum sensitivity.

    config ESPECTRE_THRESHOLD_MODE_MANUAL
        bool "MANUAL"
        help
            Fixed manual threshold from the option below.
endchoice

config ESPECTRE_SEGMENTATION_THRESHOLD_MANUAL
    string "Manual threshold"
    default "1.0"
    depends on ESPECTRE_THRESHOLD_MODE_MANUAL
    help
        Manual probability threshold in the 0.0-1.0 range.

config ESPECTRE_SEGMENTATION_WINDOW_SIZE
    int "Segmentation window size"
    range 10 200
    default 100

config ESPECTRE_TRAFFIC_GENERATOR_RATE
    int "Target valid CSI rate (pps)"
    range 0 1000
    default 100
    help
        Zero disables internal traffic generation and expects external traffic.

config ESPECTRE_TRAFFIC_GENERATOR_ADAPTIVE
    bool "Adapt traffic rate from valid CSI callbacks"
    default y
    help
        Adjust the internal DNS or ping send rate to keep valid local CSI
        callbacks close to the configured target rate.

choice ESPECTRE_TRAFFIC_GENERATOR_MODE
    prompt "Traffic generator mode"
    default ESPECTRE_TRAFFIC_GENERATOR_MODE_PING

    config ESPECTRE_TRAFFIC_GENERATOR_MODE_DNS
        bool "DNS"

    config ESPECTRE_TRAFFIC_GENERATOR_MODE_PING
        bool "PING"
endchoice

config ESPECTRE_PUBLISH_INTERVAL
    int "Publish interval (packets)"
    range 1 1000
    default 100

config ESPECTRE_EVALUATION_INTERVAL
    int "Evaluation interval (packets)"
    range 1 1000
    default 25

config ESPECTRE_MOTION_ON_HITS
    int "Motion-on hits"
    range 1 20
    default 3

config ESPECTRE_MOTION_OFF_HITS
    int "Motion-off hits"
    range 1 20
    default 3

config ESPECTRE_LOWPASS_ENABLED
    bool "Enable low-pass filter"
    default n

config ESPECTRE_LOWPASS_CUTOFF
    string "Low-pass cutoff (Hz)"
    default "11.0"
    depends on ESPECTRE_LOWPASS_ENABLED
    help
        Low-pass cutoff frequency as a decimal string in the 5.0-20.0 range.

config ESPECTRE_HAMPEL_ENABLED
    bool "Enable Hampel filter"
    default y

config ESPECTRE_HAMPEL_WINDOW
    int "Hampel window"
    range 3 11
    default 7
    depends on ESPECTRE_HAMPEL_ENABLED

config ESPECTRE_HAMPEL_THRESHOLD
    string "Hampel threshold (MAD)"
    default "5.0"
    depends on ESPECTRE_HAMPEL_ENABLED
    help
        Hampel threshold as a decimal string in the 1.0-10.0 range.

endmenu
