menu "ESPectre Matter"

choice ESPECTRE_MATTER_DETECTION_ALGORITHM
    prompt "ESPectre Matter detection algorithm"
    default ESPECTRE_MATTER_DETECTION_ALGORITHM_ML
    help
        Select the detector used by the ESPectre Matter frontend runtime.

    config ESPECTRE_MATTER_DETECTION_ALGORITHM_MVS
        bool "MVS"
        help
            Moving-variance detector with startup threshold calibration.

    config ESPECTRE_MATTER_DETECTION_ALGORITHM_ML
        bool "ML"
        help
            Neural-network detector with fixed threshold and no startup calibration.
endchoice

endmenu
