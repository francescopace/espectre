CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

CONFIG_PM_ENABLE=n
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=48

CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Dual console for debug: UART0 primary, USB Serial/JTAG secondary.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Matter over Wi-Fi
CONFIG_ENABLE_WIFI_STATION=y
CONFIG_ENABLE_WIFI_AP=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Matter identity and discovery
CONFIG_DEVICE_VENDOR_ID=0xFFF1
CONFIG_DEVICE_PRODUCT_ID=0x8000
CONFIG_DEVICE_TYPE=0x0107
CONFIG_DEFAULT_DEVICE_HARDWARE_VERSION=1
CONFIG_DEVICE_SOFTWARE_VERSION_NUMBER=300
CONFIG_ENABLE_COMMISSIONABLE_DEVICE_TYPE=y

# ESPectre Matter runtime
CONFIG_ESPECTRE_MATTER_NODE_LABEL="ESPectre Matter"

# ESPectre sensing runtime
CONFIG_ESPECTRE_DETECTION_ALGORITHM_CLASSIC=y

# Reduce CHIP serial noise in the Matter frontend by compiling out
# progress/detail logs and keeping only CHIP errors.
# CONFIG_CHIP_LOG_DEFAULT_LEVEL_EQUALS_LOG_DEFAULT_LEVEL is not set
CONFIG_CHIP_LOG_DEFAULT_LEVEL_ERROR=y

# Matter commissioning (BLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
# Keep CHIPoBLE initialized after commissioning to avoid the NimBLE
# teardown path that can crash on already-commissioned devices.
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n
CONFIG_BLE_DEVICE_NAME_PREFIX="ESPectre-"

# Matter IPv6 networking
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Required by Matter crypto (HKDF-SHA256)
CONFIG_MBEDTLS_HKDF_C=y
