CONFIG_LWIP_IRAM_OPTIMIZATION=n

# Original ESP32 has much less headroom than newer targets. Use a leaner
# network profile so the streamer can sustain collector-driven 100 pps sessions
# without exhausting RAM in the Wi-Fi/LwIP path. Keep extra TX buffering now
# that BLE is suspended during active streaming, and add a moderate RX bump to
# reduce receive-side pressure before it turns into AP retries and TX collapse.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=128
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=48
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# Shrink the preallocated CSI stream staging area on ESP32, but still leave
# enough room for one full CSI record at the protocol maximum. Keep a bit more
# queue depth than the original 8-slot profile so short Wi-Fi/LwIP stalls do
# not immediately turn into dropped CSI records at 100 pps. Allow larger
# multi-record datagrams so small real CSI payloads amortize sendto() better.
CONFIG_ESPECTRE_STREAM_QUEUE_SLOTS=12
CONFIG_ESPECTRE_STREAM_BATCH_MAX_RECORDS=6
CONFIG_ESPECTRE_STREAM_BATCH_MAX_BYTES=900