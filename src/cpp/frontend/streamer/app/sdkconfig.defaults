CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

CONFIG_PM_ENABLE=n
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
# AMPDU stays enabled on the streamer: aggregation improves link throughput for the traffic-paced stream.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=128
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128

# Dual console for debug: UART0 primary, USB Serial/JTAG secondary.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# ESPectre config
CONFIG_ESPECTRE_WIFI_CHANNEL=0
CONFIG_ESPECTRE_COLLECTOR_PORT=5001

# Shared runtime traffic ingress
CONFIG_ESPECTRE_TRAFFIC_RX_PORT=9999
CONFIG_ESPECTRE_TRAFFIC_RX_MULTICAST_GROUP="239.255.0.1"

# Streamer-local transport
CONFIG_ESPECTRE_STREAM_LOG_INTERVAL_MS=1000

# Local Wi-Fi credentials belong in sdkconfig.wifi (gitignored).
