CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_PM_ENABLE=n
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=128
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
#TODO tune
CONFIG_FREERTOS_HZ=1000
# C5 UART
# CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="ESPectre Streamer"

CONFIG_ESPECTRE_STREAM_OUTPUT_ENABLED=y
CONFIG_ESPECTRE_WIFI_CHANNEL=0
CONFIG_ESPECTRE_COLLECTOR_PORT=5001
CONFIG_ESPECTRE_TRAFFIC_RX_PORT=9999
CONFIG_ESPECTRE_STREAM_LOG_INTERVAL_MS=1000
CONFIG_ESPECTRE_STREAM_QUEUE_SLOTS=32
#TODO tune
CONFIG_ESPECTRE_STREAM_BATCH_MAX_RECORDS=4
CONFIG_ESPECTRE_STREAM_BATCH_MAX_BYTES=1200

# Local Wi-Fi credentials belong in sdkconfig.wifi (gitignored).
