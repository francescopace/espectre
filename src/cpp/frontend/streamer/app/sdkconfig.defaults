CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_PM_ENABLE=n
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPECTRE_STREAM_OUTPUT_ENABLED=y
CONFIG_ESPECTRE_COLLECTOR_PORT=5001
CONFIG_ESPECTRE_TRAFFIC_RX_PORT=9999
CONFIG_ESPECTRE_TRAFFIC_GENERATOR_RATE=0
CONFIG_ESPECTRE_GAIN_LOCK_ENABLED=y
CONFIG_ESPECTRE_GAIN_LOCK_MODE_AUTO=y
CONFIG_ESPECTRE_STREAM_QUEUE_SLOTS=8
CONFIG_ESPECTRE_STREAM_LOG_INTERVAL_MS=1000
