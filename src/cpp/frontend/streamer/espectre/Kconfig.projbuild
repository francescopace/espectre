menu "ESPectre CSI Streamer"

    config ESPECTRE_WIFI_SSID
        string "Wi-Fi SSID"
        default ""

    config ESPECTRE_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

    config ESPECTRE_WIFI_BSSID
        string "Optional Wi-Fi BSSID lock (aa:bb:cc:dd:ee:ff)"
        default ""

    config ESPECTRE_STREAM_OUTPUT_ENABLED
        bool "Enable UDP stream output"
        default y

    config ESPECTRE_COLLECTOR_PORT
        int "Collector UDP port"
        range 1 65535
        default 5001

    config ESPECTRE_TRAFFIC_RX_PORT
        int "External traffic listener UDP port"
        range 1 65535
        default 9999

    config ESPECTRE_TRAFFIC_RX_MULTICAST_GROUP
        string "Optional external traffic multicast group"
        default ""

    config ESPECTRE_GAIN_LOCK_ENABLED
        bool "Enable gain lock before streaming"
        default y

    choice ESPECTRE_GAIN_LOCK_MODE
        prompt "Gain lock mode"
        default ESPECTRE_GAIN_LOCK_MODE_AUTO

        config ESPECTRE_GAIN_LOCK_MODE_AUTO
            bool "AUTO"

        config ESPECTRE_GAIN_LOCK_MODE_ENABLED
            bool "ENABLED"

        config ESPECTRE_GAIN_LOCK_MODE_DISABLED
            bool "DISABLED"
    endchoice

    config ESPECTRE_STREAM_QUEUE_SLOTS
        int "Preallocated stream queue slots"
        range 2 32
        default 8

    config ESPECTRE_STREAM_LOG_INTERVAL_MS
        int "Telemetry log interval (ms)"
        range 100 10000
        default 1000

endmenu
