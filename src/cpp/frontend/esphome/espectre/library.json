{
  "name": "espectre",
  "version": "1.0.0",
  "description": "ESPectre CSI Motion Detection",
  "keywords": ["csi", "motion", "detection", "esp32"],
  "authors": [
    {
      "name": "Francesco Pace",
      "email": "francesco.pace@gmail.com"
    }
  ],
  "license": "GPL-3.0",
  "frameworks": "*",
  "platforms": "*",
  "build": {
    "flags": [
      "-I../../../core",
      "-I../../../runtime",
      "-I../../../runtime/esp_idf",
      "-I."
    ],
    "srcDir": ".",
    "srcFilter": [
      "+<*.cpp>",
      "-<espectre.cpp>",
      "-<calibrate_switch.cpp>",
      "-<sensor_publisher.cpp>",
      "-<threshold_number.cpp>",
      "-<traffic_generator_manager.cpp>",
      "-<udp_listener.cpp>",
      "-<wifi_lifecycle.cpp>",
      "-<esp_idf_runtime.cpp>"
    ]
  }
}


