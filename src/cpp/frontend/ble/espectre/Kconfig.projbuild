menu "ESPectre BLE Frontend"

    config ESPECTRE_WIFI_SSID
        string "Wi-Fi SSID"
        default ""

    config ESPECTRE_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

    config ESPECTRE_WIFI_BSSID
        string "Optional Wi-Fi BSSID lock (aa:bb:cc:dd:ee:ff)"
        default ""

    config ESPECTRE_WIFI_CHANNEL
        int "Optional Wi-Fi channel lock (0 = auto)"
        range 0 14
        default 0

endmenu
