# ESP32-specific product overrides.
#
# Classic ESP32 does not provide a native USB console. Keep lwIP IRAM
# optimization disabled for parity with the established target profile and
# use UART0 as the primary console.

CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64

# DNS/UDP is the validated default managed source on classic ESP32.
CONFIG_ESPECTRE_TRAFFIC_GENERATOR_MODE_DNS=y

# Validated classic ESP32 scheduling profile. Other targets retain the shared
# Direct HTTPD priority of 1 unless their target profile overrides it.
CONFIG_ESPECTRE_DIRECT_HTTPD_TASK_PRIORITY=4
