rsource "../../../runtime/esp_idf/espectre_config/Kconfig.projbuild"

menu "ESPectre Native Frontend"

    config ESPECTRE_DIRECT_DEV_ORIGINS_ENABLED
        bool "Allow loopback development portal origins"
        default n
        help
            Allow HTTP Origins on any port only when the host is exactly
            localhost, 127.0.0.1, or [::1]. Published firmware must leave
            this disabled.

    config ESPECTRE_RECOVERY_BUTTON_ENABLED
        bool "Enable long-press BOOT recovery for Wi-Fi setup"
        default y
        help
            Hold the board BOOT button to clear saved Wi-Fi credentials and
            return to Improv Serial setup. This local recovery path does not
            depend on Wi-Fi, MQTT, or a browser session.

    config ESPECTRE_RECOVERY_BUTTON_GPIO
        int "Wi-Fi recovery button GPIO"
        depends on ESPECTRE_RECOVERY_BUTTON_ENABLED
        default 28 if IDF_TARGET_ESP32C5
        default 9 if IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C6
        default 0
        range 0 48
        help
            Active-low GPIO connected to the board BOOT button. Defaults to
            the download strap used by Espressif development boards.

    config ESPECTRE_RECOVERY_BUTTON_HOLD_MS
        int "Wi-Fi recovery button hold time (ms)"
        depends on ESPECTRE_RECOVERY_BUTTON_ENABLED
        range 1000 10000
        default 3000

    config ESPECTRE_WIFI_SSID
        string "Wi-Fi SSID"
        default ""

    config ESPECTRE_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

    config ESPECTRE_WIFI_BSSID
        string "Optional Wi-Fi BSSID lock (aa:bb:cc:dd:ee:ff)"
        default ""

    config ESPECTRE_WIFI_CHANNEL
        int "Optional Wi-Fi channel hint (0 = auto)"
        range 0 177 if SOC_WIFI_SUPPORT_5G
        range 0 14
        default 0
        help
            Starts association on one channel. 0 scans normally. The runtime
            rejects values that are not 20 MHz channel centers or do not match
            the selected Wi-Fi band. Pair with a BSSID for a fixed AP radio.

    config ESPECTRE_MQTT_ENABLED
        bool "Enable MQTT telemetry"
        default n

    config ESPECTRE_DEVICE_LABEL
        string "Device label"
        default ""

    config ESPECTRE_MQTT_HOST
        string "MQTT broker host"
        default ""

    config ESPECTRE_MQTT_SCHEME
        string "MQTT broker scheme"
        default ""
        help
            Use mqtt for an explicitly plaintext connection, or mqtts for a
            TLS connection with broker certificate and hostname verification.

    config ESPECTRE_MQTT_PORT
        int "MQTT broker port"
        range 0 65535
        default 0
        help
            Zero means MQTT is not configured. A configured endpoint requires
            an explicit scheme, host, and port.

    config ESPECTRE_MQTT_USERNAME
        string "MQTT username"
        default ""

    config ESPECTRE_MQTT_PASSWORD
        string "MQTT password"
        default ""

    config ESPECTRE_TOPIC_PREFIX
        string "MQTT topic prefix"
        default "espectre/v1/devices"

    config ESPECTRE_HA_DISCOVERY_ENABLED
        bool "Enable Home Assistant MQTT Discovery adapter"
        default y

    config ESPECTRE_HA_DISCOVERY_PREFIX
        string "Home Assistant MQTT discovery prefix"
        default "homeassistant"

    menu "Advanced task scheduling"

        config ESPECTRE_NATIVE_LOOP_TASK_PRIORITY
            int "Native frontend loop task priority"
            range 1 10
            default 5
            help
                FreeRTOS priority for the Native frontend and sensing loop.
                Lowering it can delay CSI processing; raising it can starve
                Direct, managed traffic, and other lower-priority tasks.

    endmenu

endmenu
