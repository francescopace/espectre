# Classic ESP32 has materially less internal RAM and no USB Serial/JTAG.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
