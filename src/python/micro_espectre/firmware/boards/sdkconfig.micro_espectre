# Shared Micro-ESPectre performance profile.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=n
CONFIG_PM_ENABLE=n
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# ESPectre-owned native task scheduling defaults. Target profiles may override
# these values after validation without modifying the native component sources.
CONFIG_ESPECTRE_DIRECT_HTTPD_TASK_PRIORITY=1
CONFIG_ESPECTRE_TRAFFIC_TASK_PRIORITY=1

# CSI sensing consumes individual HT20 frames, not aggregated receive bursts.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# Preserve enough system heap for the Direct HTTP server after CSI calibration.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ESP_PHY_IRAM_OPT=y

# Prioritize the single IPv4 Wi-Fi station data path.
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_PPP_SUPPORT=n
CONFIG_LWIP_MAX_SOCKETS=12
# Keep room for the persistent sensing connection, Direct HTTP clients, and
# TCP PCBs waiting out TIME_WAIT after a peer closes a connection.
CONFIG_LWIP_MAX_ACTIVE_TCP=8
CONFIG_LWIP_MAX_LISTENING_TCP=2
CONFIG_LWIP_MAX_UDP_PCBS=6
CONFIG_LWIP_MAX_RAW_PCBS=4

# Advertise the bounded Direct HTTP endpoint without unused interfaces.
CONFIG_MDNS_MAX_INTERFACES=1
CONFIG_MDNS_MAX_SERVICES=1
CONFIG_MDNS_ACTION_QUEUE_LEN=8
CONFIG_MDNS_TASK_STACK_SIZE=2048
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_MDNS_MULTIPLE_INSTANCE=n
CONFIG_MDNS_PREDEF_NETIF_AP=n
CONFIG_MDNS_PREDEF_NETIF_ETH=n

# All supported newer chips provide USB Serial/JTAG alongside UART0.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
