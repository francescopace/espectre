#!/usr/bin/env python3
from __future__ import annotations

import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent
PYTHON_SRC_DIR = REPO_ROOT / "src" / "python"
if str(PYTHON_SRC_DIR) not in sys.path:
    sys.path.insert(0, str(PYTHON_SRC_DIR))

from espectre_cli.app import main

LEGACY_MICRO_COMMANDS = {
    "flash",
    "deploy",
    "run",
    "stream",
    "verify",
    "collect",
    "detect",
    "ui",
    "mqtt",
}
NEW_NAMESPACES = {"micro", "esphome", "matter", "streamer"}


def remap_legacy_args(argv: list[str]) -> list[str]:
    if not argv:
        return ["micro"]

    first = argv[0]
    if first in NEW_NAMESPACES:
        return argv
    if first in LEGACY_MICRO_COMMANDS:
        return ["micro", *argv]
    if first.startswith("-"):
        return ["micro", *argv]
    return ["micro", *argv]


if __name__ == "__main__":
    print("warning: `me` is deprecated; use `./espectre` instead", file=sys.stderr)
    raise SystemExit(main(remap_legacy_args(sys.argv[1:])))
